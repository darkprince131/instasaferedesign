# Copy to .env.local and fill in. Never commit .env.local.

# Ghost Content API (read-only) — powers the blog index at /resources/blog.
# GHOST_API_URL is the Ghost site root; lib/ghost.ts appends /ghost/api/content/…
#
# ▸ WHICH VALUE DEPENDS ON WHERE THE BUILD RUNS ▸
#
#   On the app server (EC2)    http://127.0.0.1:2368/blog
#     Ghost's own origin. Needs no proxy and cannot break. Ghost does not
#     listen off that box, so this value works nowhere else.
#
#   Anywhere else              https://instasafe.com/blog
#     Reads the Content API over the public path. This is what it was set
#     to for months and it worked — but ONLY while the web server proxies
#     /blog/ghost/api/* through to Ghost ahead of this app. Without that
#     proxy the request lands on this app's catch-all and returns a 404
#     page, and the blog index builds empty.
#
# The build log tells you which case you are in: a "[ghost] … answered 200
# with text/html, not JSON" line means the proxy is missing.
GHOST_API_URL=https://instasafe.com/blog
GHOST_CONTENT_KEY=

# NOTE: the Ghost *Admin* API key is not used by this app and must not be
# added here. It grants write access to the whole publication; nothing in the
# site build needs it.

# ---- trackers (all optional, all consent-gated) ----
# Rendered by components/consent/GatedScripts.tsx ONLY after the visitor
# grants the matching consent category; unset var = tracker fully off.
# NEXT_PUBLIC_ values are baked into the bundle at BUILD time — changing
# one requires a rebuild, not just a restart.
#
# GTM-WTSSPHW is the container the old site ran; GA4 is configured inside
# it. Do NOT also set NEXT_PUBLIC_GA_ID unless GA4 is removed from the
# container — both firing means every pageview counts twice.
NEXT_PUBLIC_GTM_ID=GTM-WTSSPHW
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_ZOHO_PAGESENSE_ID=
# NEXT_PUBLIC_CLEARBIT_ID=
