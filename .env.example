# Copy to .env.local and fill in. Never commit .env.local.

# Ghost Content API (read-only) — powers the blog index at /resources/blog.
# GHOST_API_URL is the Ghost site root; lib/ghost.ts appends /ghost/api/content/…
#
# ▸ THIS MUST BE THE GHOST ORIGIN, NOT THE PUBLIC BLOG URL ▸
# Since this app started serving the apex, https://instasafe.com/blog is
# THIS SITE. Pointing the variable there makes the app request the Content
# API from itself, get its own 404 page back, and render an empty index.
# On the app server Ghost is local:
#
#   GHOST_API_URL=http://127.0.0.1:2368/blog
#
# Ghost is not reachable from outside that box, so an external build host
# (Netlify, a laptop) will render an empty blog index. That is expected.
GHOST_API_URL=http://127.0.0.1:2368/blog
GHOST_CONTENT_KEY=

# NOTE: the Ghost *Admin* API key is not used by this app and must not be
# added here. It grants write access to the whole publication; nothing in the
# site build needs it.
